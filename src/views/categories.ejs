<%- include('partials/header') %>
    <main class="content-page">
        <section class="page-intro" aria-labelledby="categories-heading">
            <p class="eyebrow">Find your fit</p>
            <h1 id="categories-heading"><%= title %></h1>
            <p class="intro-copy">Explore service opportunities by the kind of impact you want to make.</p>
            <% if (user && user.role === 'admin') { %>
                <a class="btn btn-primary" href="/new-category">Add New Category</a>
            <% } %>
        </section>
        <section aria-labelledby="category-heading">
            <div class="section-heading">
                <!-- <h2 id="category-heading">Browse by focus</h2> -->
                <span class="section-rule" aria-hidden="true"></span>
            </div>

            <div class="table-wrapper">
                <table class="data-table">
                    <caption class="visually-hidden">Available service project categories</caption>
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Category</th>
                            <th scope="col">Selection</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach((category, index) => { %>
                            <tr>
                                <td data-label="ID"><%= index + 1 %></td>
                                <th scope="row" data-label="Category"><%= category.name %></th>
                                <td data-label="Selection">
                                    <a class="btn btn-primary" href="/category/<%= category.category_id %>">View Projects</a>
                                    <% if (user && user.role === 'admin') { %>
                                        <a class="btn btn-primary" href="/edit-category/<%= category.category_id %>">Edit Category</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    <%- include('partials/footer') %>