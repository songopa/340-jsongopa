<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>

        <form class="form" action="/edit-organization/<%= organization.organization_id %>" method="POST">
            <div class="form-group">
                <label for="name">Organization Name</label>
                <input type="text" id="name" name="name" value="<%= organization.name %>" required minlength="3" maxlength="150" <%= errors.name ? 'aria-invalid="true"' : '' %> />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="500" <%= errors.description ? 'aria-invalid="true"' : '' %>><%= organization.description %></textarea>
                
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email %>" required <%= errors.contactEmail ? 'aria-invalid="true"' : '' %> />
              
            </div>

            <div class="form-actions">
                <button class="btn btn-secondary" type="submit">Save Changes</button>
                <a class="btn btn-primary" href="/organization/<%= organization.organization_id %>">Cancel</a>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>
