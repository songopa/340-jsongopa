<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>

        <form class="form" action="/edit-project/<%= project.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" required minlength="3" maxlength="200">
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="999"><%= project.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" required maxlength="199">
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" value="<%= new Date(project.project_date).toISOString().slice(0, 10) %>" required>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <% organizations.forEach(organization => { %>
                        <option value="<%= organization.organization_id %>" <%= organization.organization_id === project.organization_id ? 'selected' : '' %>>
                            <%= organization.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-actions">
                <button class="btn btn-secondary" type="submit">Save Changes</button>
                <a class="btn btn-primary" href="/project/<%= project.project_id %>">Cancel</a>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>
