<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
    <script src="/js/script.js" defer></script>
</head>

<body>
    <nav>
        <div class="nav-inner">
            <a class="site-brand" href="/" aria-label="CSE 340 Service Network home">
                <img src="/images/cse340-service-network.png" alt="">
                <span>Service Network</span>
            </a>
            <ul>
                <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a></li>
                <li><a href="/organizations" class="<%= currentPath === '/organizations' ? 'active' : '' %>" <%= currentPath === '/organizations' ? 'aria-current="page"' : '' %>>Organizations</a></li>
                <li><a href="/projects" class="<%= currentPath === '/projects' ? 'active' : '' %>" <%= currentPath === '/projects' ? 'aria-current="page"' : '' %>>Projects</a></li>
                <li><a href="/categories" class="<%= currentPath === '/categories' ? 'active' : '' %>" <%= currentPath === '/categories' ? 'aria-current="page"' : '' %>>Categories</a></li>
            </ul>
            <div class="nav-right">
                <% if (isLoggedIn) { %>
                    <a href="/logout" class="<%= currentPath === '/logout' ? 'active' : '' %>" <%= currentPath === '/logout' ? 'aria-current="page"' : '' %>>Logout</a>
                <% } else { %>
                    <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>" <%= currentPath === '/login' ? 'aria-current="page"' : '' %>>Login</a>
                    <a href="/register" class="<%= currentPath === '/register' ? 'active' : '' %>" <%= currentPath === '/register' ? 'aria-current="page"' : '' %>>Register</a>
                <% } %>
            </div>
        </div>
    </nav>
    
    <% const messages = flash(); %>
    <% const alertTypes = ['success', 'error', 'warning', 'info']; %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <% const alertType = alertTypes.includes(type) ? type : 'info'; %>
            <% messages[type].forEach(msg => { %>
                <div class="alert alert--<%= alertType %>" role="<%= alertType === 'error' ? 'alert' : 'status' %>" aria-live="polite">
                    <%= msg %>
                </div>
            <% }); %>
        <% } %>
    <% }); %>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const flashMessages = document.querySelectorAll('.alert');
            if (flashMessages.length > 0) {
                setTimeout(() => {
                    flashMessages.forEach(msg => msg.remove());
                }, 5000);
            }
        });
        document.addEventListener('click', (e) => {
            if (e.target.classList.contains('alert')) {
                e.target.remove();
            }
        });
    </script>