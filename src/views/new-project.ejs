<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>

        <form class="form" action="/new-project" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" required minlength="3" maxlength="200">
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="999"></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" required maxlength="199">
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(organization => { %>
                        <option value="<%= organization.organization_id %>"><%= organization.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-actions">
                <button class="btn btn-secondary" type="submit">Create Project</button>
                <a class="btn btn-primary" href="/projects">Cancel</a>
            </div>
        </form>
    </main>
    <%- include('partials/footer') %>
