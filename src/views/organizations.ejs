<%- include('partials/header') %>
    <main class="content-page">
        <section class="page-intro" aria-labelledby="organizations-heading">
            <p class="eyebrow">People powering local change</p>
            <h1 id="organizations-heading"><%= title %></h1>
            <p class="intro-copy">Meet the partner organizations creating opportunities for volunteers to serve with purpose.</p>
        </section>
        <section aria-labelledby="partners-heading">
            <div class="section-heading">
                <% if (user && user.role_name === 'admin') { %>
                    <a href="/new-organization" class="btn btn-primary">Add New Organization</a>
                <% } %>
                <span class="section-rule" aria-hidden="true"></span>
            </div>
            <ul class="content-list">
            <% organizations.forEach(org => { %>
                <li class="content-card content-card--organization">
                    <img class="content-image" src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
                    <div>
                        <h3>
                            <a href="/organization/<%= org.organization_id %>" ><%= org.name %></a>
                        </h3>
                        <p><%= org.description %></p>
                        <dl class="content-details">
                            <div>
                                <dt>Contact</dt>
                                <dd><%= org.contact_email %></dd>
                            </div>
                            <div>
                                
                            </div>
                        </dl>
                    </div>
                </li>
                <% }); %>
            </ul>
        </section>
    </main>
    <%- include('partials/footer') %>
