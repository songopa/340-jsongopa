<%- include('partials/header') %>
    <main class="content-page">
        <section class="page-intro" aria-labelledby="projects-heading">
            <p class="eyebrow">Make an impact locally</p>
            <h1 id="projects-heading"><%= title %></h1>
        </section>

        <section aria-labelledby="upcoming-heading">
            <div class="section-heading">
                <h2 id="upcoming-heading">Upcoming opportunities</h2>
                <span class="section-rule" aria-hidden="true"></span>
            </div>

            <% if (projects.length > 0) { %>
                <ul class="content-list">
                    <% projects.forEach(project => { %>
                        <li class="content-card">
                            <div class="content-card__topline">
                                <span class="content-label">Service project</span>
                                <span class="content-number" aria-hidden="true"><%= String(project.project_id).padStart(2, '0') %></span>
                            </div>
                            <h3><%= project.title %></h3>
                            <p><%= project.description %></p>
                            <dl class="content-details">
                                <div>
                                    <dt>Organization</dt>
                                    <dd><%= project.organization_name %></dd>
                                </div>
                                <div>
                                    <dt>Where</dt>
                                    <dd><%= project.location %></dd>
                                </div>
                                <div>
                                    <dt>When</dt>
                                    <dd><%= project.project_date.toDateString() %></dd>
                                </div>
                            </dl>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p class="empty-state">There are no upcoming projects listed right now. Please check back soon for new ways to serve.</p>
            <% } %>
        </section>
    </main>
    <%- include('partials/footer') %>